;; array.copy of an array of numbers is one memmove in the runtime
;; (warmc_array_copy), of the elements' count times their width in bytes
;; from each index times the width, whichever the width.  For 1-, 2-, 4- and
;; 8-byte elements: every length from 0 to 80, and the ones whose bytes
;; straddle where the runtime's memmove hands an overlapping copy, and then
;; any, to the platform's (512 and 65536 bytes); each within one array at
;; shifts that overlap the source either way by one element, by all but
;; one, or not at all, and from another array.  Every element of the
;; destination is checked, a wrong one unreachable.
(module
  (type $a8 (array (mut i8)))
  (type $a16 (array (mut i16)))
  (type $a32 (array (mut i32)))
  (type $a64 (array (mut i64)))

  ;; element i of a fresh array: a hash of i and the array's salt
  (func $v8 (param $i i32) (param $salt i32) (result i32)
    (i32.and (i32.add (i32.shr_u (i32.mul (local.get $i) (i32.const 0x9e3779b1)) (i32.const 7)) (local.get $salt)) (i32.const 0xff)))
  (func $make8 (param $len i32) (param $salt i32) (result (ref $a8))
    (local $a (ref $a8)) (local $i i32)
    (local.set $a (array.new_default $a8 (local.get $len)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (array.set $a8 (local.get $a) (local.get $i) (call $v8 (local.get $i) (local.get $salt)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.get $a))
  ;; n elements from s's index si (an array salted ss) to d's index di (an
  ;; array salted ds), checked across the whole of d
  (func $case8 (param $d (ref $a8)) (param $ds i32) (param $di i32)
                  (param $s (ref $a8)) (param $ss i32) (param $si i32) (param $n i32)
    (local $i i32)
    (array.copy $a8 $a8 (local.get $d) (local.get $di) (local.get $s) (local.get $si) (local.get $n))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (array.len (local.get $d))))
      (if (i32.ne (array.get_u $a8 (local.get $d) (local.get $i))
                  (if (result i32) (i32.lt_u (i32.sub (local.get $i) (local.get $di)) (local.get $n))
                    (then (call $v8 (i32.add (i32.sub (local.get $i) (local.get $di)) (local.get $si))
                                       (local.get $ss)))
                    (else (call $v8 (local.get $i) (local.get $ds)))))
        (then unreachable))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  ;; length n at the shifts, within one array and from another
  (func $len8 (param $n i32)
    (local $k i32) (local $sh i32) (local $si i32) (local $len i32)
    (local.set $si (i32.add (local.get $n) (i32.const 40)))
    (local.set $len (i32.add (i32.mul (local.get $n) (i32.const 3)) (i32.const 100)))
    (loop $lk
      (local.set $sh
        (block $b (result i32)
          (block $b10 (block $b9 (block $b8 (block $b7 (block $b6 (block $b5
          (block $b4 (block $b3 (block $b2 (block $b1 (block $b0
            (br_table $b0 $b1 $b2 $b3 $b4 $b5 $b6 $b7 $b8 $b9 $b10 (local.get $k)))
            (br $b (i32.sub (i32.const -1) (local.get $n))))
            (br $b (i32.sub (i32.const 0) (local.get $n))))
            (br $b (i32.sub (i32.const 1) (local.get $n))))
            (br $b (i32.const -17)))
            (br $b (i32.const -1)))
            (br $b (i32.const 0)))
            (br $b (i32.const 1)))
            (br $b (i32.const 17)))
            (br $b (i32.sub (local.get $n) (i32.const 1))))
            (br $b (local.get $n)))
          (i32.add (local.get $n) (i32.const 1))))
      (call $case8 (call $make8 (local.get $len) (i32.const 1)) (i32.const 1)
                      (i32.add (local.get $si) (local.get $sh))
                      (call $make8 (local.get $len) (i32.const 3)) (i32.const 3)
                      (local.get $si) (local.get $n))
      (call $within8 (local.get $len) (i32.add (local.get $si) (local.get $sh))
                        (local.get $si) (local.get $n))
      (br_if $lk (i32.le_u (local.tee $k (i32.add (local.get $k) (i32.const 1)))
                           (i32.const 10)))))
  (func $within8 (param $len i32) (param $di i32) (param $si i32) (param $n i32)
    (local $a (ref $a8))
    (local.set $a (call $make8 (local.get $len) (i32.const 2)))
    (call $case8 (local.get $a) (i32.const 2) (local.get $di)
                    (local.get $a) (i32.const 2) (local.get $si) (local.get $n)))
  (func (export "array_copy_8")
    (local $n i32)
    (loop $l
      (call $len8 (local.get $n))
      (br_if $l (i32.le_u (local.tee $n (i32.add (local.get $n) (i32.const 1)))
                          (i32.const 80))))
    (call $len8 (i32.const 511))
    (call $len8 (i32.const 512))
    (call $len8 (i32.const 513))
    (call $len8 (i32.const 65535))
    (call $len8 (i32.const 65536))
    (call $len8 (i32.const 65537)))

  ;; element i of a fresh array: a hash of i and the array's salt
  (func $v16 (param $i i32) (param $salt i32) (result i32)
    (i32.and (i32.add (i32.shr_u (i32.mul (local.get $i) (i32.const 0x9e3779b1)) (i32.const 7)) (local.get $salt)) (i32.const 0xffff)))
  (func $make16 (param $len i32) (param $salt i32) (result (ref $a16))
    (local $a (ref $a16)) (local $i i32)
    (local.set $a (array.new_default $a16 (local.get $len)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (array.set $a16 (local.get $a) (local.get $i) (call $v16 (local.get $i) (local.get $salt)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.get $a))
  ;; n elements from s's index si (an array salted ss) to d's index di (an
  ;; array salted ds), checked across the whole of d
  (func $case16 (param $d (ref $a16)) (param $ds i32) (param $di i32)
                  (param $s (ref $a16)) (param $ss i32) (param $si i32) (param $n i32)
    (local $i i32)
    (array.copy $a16 $a16 (local.get $d) (local.get $di) (local.get $s) (local.get $si) (local.get $n))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (array.len (local.get $d))))
      (if (i32.ne (array.get_u $a16 (local.get $d) (local.get $i))
                  (if (result i32) (i32.lt_u (i32.sub (local.get $i) (local.get $di)) (local.get $n))
                    (then (call $v16 (i32.add (i32.sub (local.get $i) (local.get $di)) (local.get $si))
                                       (local.get $ss)))
                    (else (call $v16 (local.get $i) (local.get $ds)))))
        (then unreachable))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  ;; length n at the shifts, within one array and from another
  (func $len16 (param $n i32)
    (local $k i32) (local $sh i32) (local $si i32) (local $len i32)
    (local.set $si (i32.add (local.get $n) (i32.const 40)))
    (local.set $len (i32.add (i32.mul (local.get $n) (i32.const 3)) (i32.const 100)))
    (loop $lk
      (local.set $sh
        (block $b (result i32)
          (block $b10 (block $b9 (block $b8 (block $b7 (block $b6 (block $b5
          (block $b4 (block $b3 (block $b2 (block $b1 (block $b0
            (br_table $b0 $b1 $b2 $b3 $b4 $b5 $b6 $b7 $b8 $b9 $b10 (local.get $k)))
            (br $b (i32.sub (i32.const -1) (local.get $n))))
            (br $b (i32.sub (i32.const 0) (local.get $n))))
            (br $b (i32.sub (i32.const 1) (local.get $n))))
            (br $b (i32.const -17)))
            (br $b (i32.const -1)))
            (br $b (i32.const 0)))
            (br $b (i32.const 1)))
            (br $b (i32.const 17)))
            (br $b (i32.sub (local.get $n) (i32.const 1))))
            (br $b (local.get $n)))
          (i32.add (local.get $n) (i32.const 1))))
      (call $case16 (call $make16 (local.get $len) (i32.const 1)) (i32.const 1)
                      (i32.add (local.get $si) (local.get $sh))
                      (call $make16 (local.get $len) (i32.const 3)) (i32.const 3)
                      (local.get $si) (local.get $n))
      (call $within16 (local.get $len) (i32.add (local.get $si) (local.get $sh))
                        (local.get $si) (local.get $n))
      (br_if $lk (i32.le_u (local.tee $k (i32.add (local.get $k) (i32.const 1)))
                           (i32.const 10)))))
  (func $within16 (param $len i32) (param $di i32) (param $si i32) (param $n i32)
    (local $a (ref $a16))
    (local.set $a (call $make16 (local.get $len) (i32.const 2)))
    (call $case16 (local.get $a) (i32.const 2) (local.get $di)
                    (local.get $a) (i32.const 2) (local.get $si) (local.get $n)))
  (func (export "array_copy_16")
    (local $n i32)
    (loop $l
      (call $len16 (local.get $n))
      (br_if $l (i32.le_u (local.tee $n (i32.add (local.get $n) (i32.const 1)))
                          (i32.const 80))))
    (call $len16 (i32.const 255))
    (call $len16 (i32.const 256))
    (call $len16 (i32.const 257))
    (call $len16 (i32.const 32767))
    (call $len16 (i32.const 32768))
    (call $len16 (i32.const 32769)))

  ;; element i of a fresh array: a hash of i and the array's salt
  (func $v32 (param $i i32) (param $salt i32) (result i32)
    (i32.add (i32.shr_u (i32.mul (local.get $i) (i32.const 0x9e3779b1)) (i32.const 7)) (local.get $salt)))
  (func $make32 (param $len i32) (param $salt i32) (result (ref $a32))
    (local $a (ref $a32)) (local $i i32)
    (local.set $a (array.new_default $a32 (local.get $len)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (array.set $a32 (local.get $a) (local.get $i) (call $v32 (local.get $i) (local.get $salt)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.get $a))
  ;; n elements from s's index si (an array salted ss) to d's index di (an
  ;; array salted ds), checked across the whole of d
  (func $case32 (param $d (ref $a32)) (param $ds i32) (param $di i32)
                  (param $s (ref $a32)) (param $ss i32) (param $si i32) (param $n i32)
    (local $i i32)
    (array.copy $a32 $a32 (local.get $d) (local.get $di) (local.get $s) (local.get $si) (local.get $n))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (array.len (local.get $d))))
      (if (i32.ne (array.get $a32 (local.get $d) (local.get $i))
                  (if (result i32) (i32.lt_u (i32.sub (local.get $i) (local.get $di)) (local.get $n))
                    (then (call $v32 (i32.add (i32.sub (local.get $i) (local.get $di)) (local.get $si))
                                       (local.get $ss)))
                    (else (call $v32 (local.get $i) (local.get $ds)))))
        (then unreachable))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  ;; length n at the shifts, within one array and from another
  (func $len32 (param $n i32)
    (local $k i32) (local $sh i32) (local $si i32) (local $len i32)
    (local.set $si (i32.add (local.get $n) (i32.const 40)))
    (local.set $len (i32.add (i32.mul (local.get $n) (i32.const 3)) (i32.const 100)))
    (loop $lk
      (local.set $sh
        (block $b (result i32)
          (block $b10 (block $b9 (block $b8 (block $b7 (block $b6 (block $b5
          (block $b4 (block $b3 (block $b2 (block $b1 (block $b0
            (br_table $b0 $b1 $b2 $b3 $b4 $b5 $b6 $b7 $b8 $b9 $b10 (local.get $k)))
            (br $b (i32.sub (i32.const -1) (local.get $n))))
            (br $b (i32.sub (i32.const 0) (local.get $n))))
            (br $b (i32.sub (i32.const 1) (local.get $n))))
            (br $b (i32.const -17)))
            (br $b (i32.const -1)))
            (br $b (i32.const 0)))
            (br $b (i32.const 1)))
            (br $b (i32.const 17)))
            (br $b (i32.sub (local.get $n) (i32.const 1))))
            (br $b (local.get $n)))
          (i32.add (local.get $n) (i32.const 1))))
      (call $case32 (call $make32 (local.get $len) (i32.const 1)) (i32.const 1)
                      (i32.add (local.get $si) (local.get $sh))
                      (call $make32 (local.get $len) (i32.const 3)) (i32.const 3)
                      (local.get $si) (local.get $n))
      (call $within32 (local.get $len) (i32.add (local.get $si) (local.get $sh))
                        (local.get $si) (local.get $n))
      (br_if $lk (i32.le_u (local.tee $k (i32.add (local.get $k) (i32.const 1)))
                           (i32.const 10)))))
  (func $within32 (param $len i32) (param $di i32) (param $si i32) (param $n i32)
    (local $a (ref $a32))
    (local.set $a (call $make32 (local.get $len) (i32.const 2)))
    (call $case32 (local.get $a) (i32.const 2) (local.get $di)
                    (local.get $a) (i32.const 2) (local.get $si) (local.get $n)))
  (func (export "array_copy_32")
    (local $n i32)
    (loop $l
      (call $len32 (local.get $n))
      (br_if $l (i32.le_u (local.tee $n (i32.add (local.get $n) (i32.const 1)))
                          (i32.const 80))))
    (call $len32 (i32.const 127))
    (call $len32 (i32.const 128))
    (call $len32 (i32.const 129))
    (call $len32 (i32.const 16383))
    (call $len32 (i32.const 16384))
    (call $len32 (i32.const 16385)))

  ;; element i of a fresh array: a hash of i and the array's salt
  (func $v64 (param $i i32) (param $salt i32) (result i64)
    (i64.or (i64.shl (i64.extend_i32_u (i32.add (i32.shr_u (i32.mul (local.get $i) (i32.const 0x9e3779b1)) (i32.const 7)) (local.get $salt))) (i64.const 32)) (i64.const 0x55)))
  (func $make64 (param $len i32) (param $salt i32) (result (ref $a64))
    (local $a (ref $a64)) (local $i i32)
    (local.set $a (array.new_default $a64 (local.get $len)))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (array.set $a64 (local.get $a) (local.get $i) (call $v64 (local.get $i) (local.get $salt)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l)))
    (local.get $a))
  ;; n elements from s's index si (an array salted ss) to d's index di (an
  ;; array salted ds), checked across the whole of d
  (func $case64 (param $d (ref $a64)) (param $ds i32) (param $di i32)
                  (param $s (ref $a64)) (param $ss i32) (param $si i32) (param $n i32)
    (local $i i32)
    (array.copy $a64 $a64 (local.get $d) (local.get $di) (local.get $s) (local.get $si) (local.get $n))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (array.len (local.get $d))))
      (if (i64.ne (array.get $a64 (local.get $d) (local.get $i))
                  (if (result i64) (i32.lt_u (i32.sub (local.get $i) (local.get $di)) (local.get $n))
                    (then (call $v64 (i32.add (i32.sub (local.get $i) (local.get $di)) (local.get $si))
                                       (local.get $ss)))
                    (else (call $v64 (local.get $i) (local.get $ds)))))
        (then unreachable))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $l))))
  ;; length n at the shifts, within one array and from another
  (func $len64 (param $n i32)
    (local $k i32) (local $sh i32) (local $si i32) (local $len i32)
    (local.set $si (i32.add (local.get $n) (i32.const 40)))
    (local.set $len (i32.add (i32.mul (local.get $n) (i32.const 3)) (i32.const 100)))
    (loop $lk
      (local.set $sh
        (block $b (result i32)
          (block $b10 (block $b9 (block $b8 (block $b7 (block $b6 (block $b5
          (block $b4 (block $b3 (block $b2 (block $b1 (block $b0
            (br_table $b0 $b1 $b2 $b3 $b4 $b5 $b6 $b7 $b8 $b9 $b10 (local.get $k)))
            (br $b (i32.sub (i32.const -1) (local.get $n))))
            (br $b (i32.sub (i32.const 0) (local.get $n))))
            (br $b (i32.sub (i32.const 1) (local.get $n))))
            (br $b (i32.const -17)))
            (br $b (i32.const -1)))
            (br $b (i32.const 0)))
            (br $b (i32.const 1)))
            (br $b (i32.const 17)))
            (br $b (i32.sub (local.get $n) (i32.const 1))))
            (br $b (local.get $n)))
          (i32.add (local.get $n) (i32.const 1))))
      (call $case64 (call $make64 (local.get $len) (i32.const 1)) (i32.const 1)
                      (i32.add (local.get $si) (local.get $sh))
                      (call $make64 (local.get $len) (i32.const 3)) (i32.const 3)
                      (local.get $si) (local.get $n))
      (call $within64 (local.get $len) (i32.add (local.get $si) (local.get $sh))
                        (local.get $si) (local.get $n))
      (br_if $lk (i32.le_u (local.tee $k (i32.add (local.get $k) (i32.const 1)))
                           (i32.const 10)))))
  (func $within64 (param $len i32) (param $di i32) (param $si i32) (param $n i32)
    (local $a (ref $a64))
    (local.set $a (call $make64 (local.get $len) (i32.const 2)))
    (call $case64 (local.get $a) (i32.const 2) (local.get $di)
                    (local.get $a) (i32.const 2) (local.get $si) (local.get $n)))
  (func (export "array_copy_64")
    (local $n i32)
    (loop $l
      (call $len64 (local.get $n))
      (br_if $l (i32.le_u (local.tee $n (i32.add (local.get $n) (i32.const 1)))

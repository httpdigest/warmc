;; Calls of C functions as --native-module imports (test/native/natives.c):
;; each result checked here, the program exiting with the number of the
;; first that is wrong, or printing "native: ok".
(module
  (import "wasi_snapshot_preview1" "fd_write" (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $proc_exit (param i32)))
  (import "c" "nat_i32" (func $nat_i32 (param i32 i32) (result i32)))
  (import "c" "nat_i64" (func $nat_i64 (param i64 i32 i64) (result i64)))
  (import "c" "nat_f32" (func $nat_f32 (param f32 f32) (result f32)))
  (import "c" "nat_f64" (func $nat_f64 (param f64 f32 f64) (result f64)))
  (import "c" "nat_void" (func $nat_void))
  (import "c" "nat_ints" (func $nat_ints (param i32 i64 i32 i32 i64 i32 i32 i64 i32 i64 i32 i32 i64) (result i64)))
  (import "c" "nat_floats" (func $nat_floats (param f32 f64 f32 f64 f32 f64 f32 f64 f32 f64 f32 f64) (result f64)))
  (import "c" "nat_mixed" (func $nat_mixed (param i32 f32 i64 f64 i32 f32 i32 i32 i32 i32 i32 i64 f32 f64 f32 f64 f32 f64 f32 i32) (result f64)))
  (import "c" "nat_clobber" (func $nat_clobber (param i32) (result i32)))
  (import "c" "nat_call_back" (func $nat_call_back (param i32) (result i32)))
  (import "c" "nat_read" (func $nat_read (param i64) (result i32)))
  (import "c" "nat_write" (func $nat_write (param i64 i32)))
  ;; not C's: memory 0's base, the native address of offset 0
  (import "c" "warmc_memory_base" (func $base (result i64)))
  (memory (export "memory") 1)
  (data (i32.const 16) "native: ok\n")

  (func $check (param $ok i32) (param $n i32)
    (if (i32.eqz (local.get $ok)) (then (call $proc_exit (local.get $n)))))

  ;; a tail call of C is a call and a return
  (func $tail (param i32 i32) (result i32)
    (return_call $nat_i32 (local.get 0) (local.get 1)))

  ;; what nat_call_back calls, itself calling C
  (func (export "back") (param $i i32) (result i32)
    (i32.add (i32.mul (local.get $i) (local.get $i))
             (call $nat_i32 (local.get $i) (i32.const 1))))

  (func (export "_start")
    (local $a i32) (local $b i64) (local $c f64) (local $d f32) (local $k i32) (local $sum i32)
    (call $check (i32.eq (call $nat_i32 (i32.const -3) (i32.const 7)) (i32.const -23)) (i32.const 1))
    (call $check (i64.eq (call $nat_i64 (i64.const 1000000000000) (i32.const -4) (i64.const 5))
                         (i64.const 1000000000020)) (i32.const 2))
    (call $check (f32.eq (call $nat_f32 (f32.const 1.5) (f32.const 0.5)) (f32.const 3)) (i32.const 3))
    (call $check (f64.eq (call $nat_f64 (f64.const 2.5) (f32.const 4) (f64.const 0.25)) (f64.const 10.25))
                 (i32.const 4))
    (call $nat_void)
    (call $check (i64.eq (call $nat_ints (i32.const 1) (i64.const 0x100000000) (i32.const 3) (i32.const 4)
                                         (i64.const 5) (i32.const 6) (i32.const 7) (i64.const 8)
                                         (i32.const -9) (i64.const 10) (i32.const 11) (i32.const 12)
                                         (i64.const 13))
                         (i64.const 8589935245)) (i32.const 5))
    (call $check (f64.eq (call $nat_floats (f32.const 1) (f64.const 2) (f32.const 3) (f64.const 4)
                                           (f32.const 5) (f64.const 6) (f32.const 7) (f64.const 8)
                                           (f32.const 9) (f64.const 10) (f32.const 11) (f64.const 12))
                         (f64.const 650)) (i32.const 6))
    (call $check (f64.eq (call $nat_mixed (i32.const 1) (f32.const 2) (i64.const 3) (f64.const 4)
                                          (i32.const 5) (f32.const 6) (i32.const 7) (i32.const 8)
                                          (i32.const 9) (i32.const 10) (i32.const 11) (i64.const 12)
                                          (f32.const 13) (f64.const 14) (f32.const 15) (f64.const 16)
                                          (f32.const 17) (f64.const 18) (f32.const 19) (i32.const 20))
                         (f64.const 20190)) (i32.const 7))
    ;; values live across calls that write every caller-saved register
    (local.set $a (i32.const 0x1234567))
    (local.set $b (i64.const 0x123456789abcdef))
    (local.set $c (f64.const 3.25))
    (local.set $d (f32.const -7.5))
    (local.set $k (i32.const 0))
    (loop $again
      (local.set $sum (i32.add (local.get $sum) (call $nat_clobber (i32.const 3))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get $k) (i32.const 4))))
    (call $check (i32.eq (local.get $sum) (i32.const 3228)) (i32.const 8))
    (call $check (i32.eq (local.get $a) (i32.const 0x1234567)) (i32.const 9))
    (call $check (i64.eq (local.get $b) (i64.const 0x123456789abcdef)) (i32.const 10))
    (call $check (f64.eq (local.get $c) (f64.const 3.25)) (i32.const 11))
    (call $check (f32.eq (local.get $d) (f32.const -7.5)) (i32.const 12))
    (call $check (i32.eq (call $tail (i32.const 4) (i32.const 5)) (i32.const 45)) (i32.const 13))
    (call $check (i32.eq (call $nat_call_back (i32.const 5)) (i32.const 135)) (i32.const 14))
    ;; C reading and writing linear memory at the native address of an offset
    (i32.store (i32.const 64) (i32.const 0x5a5a))
    (call $check (i32.eq (call $nat_read (i64.add (call $base) (i64.const 64))) (i32.const 0x5a5a))
                 (i32.const 15))
    (call $nat_write (i64.add (call $base) (i64.const 72)) (i32.const -77))
    (call $check (i32.eq (i32.load (i32.const 72)) (i32.const -77)) (i32.const 16))
    (i32.store (i32.const 0) (i32.const 16))
    (i32.store (i32.const 4) (i32.const 11))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))))

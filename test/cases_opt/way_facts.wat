;; shape: bt_i32_br_v \slsl\s+[wx]\d=0
;; shape: bt_i64_eqz_v \slsr\s+[wx]\d=1
;; shape: bt_i64_eqz_v \slsl\s+[wx]\d=0
;; shape: bt_i32_value \slsl\s+[wx]\d=1
;; shape: bt_i32_value \slsr\s+[wx]\d=0
;; shape: nest0 \sand\s=2
;; shape: nest2 \sand\s=1
;; shape: merge0 \sand\s=0
;; shape: ascii \sand\s=2

;; Float sums and products a loop carries round, which -O3's float-reassoc
;; takes in another order than wasm's: in vector lanes, each a partial
;; result added (multiplied) together at the loop's end, -0 (1) their
;; start -- sum64, sum32, dot64, dot32, prod64, and negzero, whose -0s
;; from -0 sum to -0 -- and a chain of three terms onto the sum made the
;; terms' sum first, then the sum's add (three64, which the vectoriser,
;; before that, does not take).  Straight-line sums and products take their
;; deepest term last (chainadd, chainmul).  A difference keeps wasm's order
;; (diff64, chainsub).  -O2 does none of it.  The values
;; are small integers and powers of two, so every order gives one answer,
;; the one worked out by test/gen_floatreassoc.py; a float answer, and an
;; argument, is given as its bits.
;;
;; stats -O2: vectorised=0 reassoc=0
;; stats -O3: vectorised=6 reassoc=5
;;
;; run: sum64 0 => f64:0x0000000000000000
;; run: sum64 1 => f64:0xc018000000000000
;; run: sum64 5 => f64:0xc028000000000000
;; run: sum64 17 => f64:0xc020000000000000
;; run: sum64 64 => f64:0x0000000000000000
;; run: sum32 0 => f32:0x00000000
;; run: sum32 1 => f32:0xc0c00000
;; run: sum32 5 => f32:0xc1400000
;; run: sum32 17 => f32:0xc1000000
;; run: sum32 64 => f32:0x00000000
;; run: dot64 0 => f64:0x0000000000000000
;; run: dot64 1 => f64:0x403e000000000000
;; run: dot64 5 => f64:0xc02a000000000000
;; run: dot64 17 => f64:0xc062c00000000000
;; run: dot64 64 => f64:0xc067a00000000000
;; run: dot32 0 => f32:0x00000000
;; run: dot32 1 => f32:0x41f00000
;; run: dot32 5 => f32:0xc1500000
;; run: dot32 17 => f32:0xc3160000
;; run: dot32 64 => f32:0xc33d0000
;; run: prod64 0 => f64:0x3ff0000000000000
;; run: prod64 1 => f64:0x3fe0000000000000
;; run: prod64 5 => f64:0x3fe0000000000000
;; run: prod64 17 => f64:0x3fe0000000000000
;; run: prod64 64 => f64:0x3ff0000000000000
;; run: three64 0 => f64:0x0000000000000000
;; run: three64 1 => f64:0xc020000000000000
;; run: three64 5 => f64:0x4018000000000000
;; run: three64 17 => f64:0x4046000000000000
;; run: three64 64 => f64:0x4068600000000000
;; run: negzero 0 => f64:0x8000000000000000
;; run: negzero 1 => f64:0x8000000000000000
;; run: negzero 5 => f64:0x8000000000000000
;; run: negzero 17 => f64:0x8000000000000000
;; run: negzero 64 => f64:0x8000000000000000
;; run: diff64 0 => f64:0x4059000000000000
;; run: diff64 1 => f64:0x405a800000000000
;; run: diff64 5 => f64:0x405c000000000000
;; run: diff64 17 => f64:0x405b000000000000
;; run: diff64 64 => f64:0x4059000000000000
;; run: chainadd 0x0000000000000000 0x0000000000000000 => f64:0x4020000000000000
;; run: chainadd 0x4000000000000000 0x4008000000000000 => f64:0x403b000000000000
;; run: chainadd 0xc008000000000000 0x401c000000000000 => f64:0x4058000000000000
;; run: chainadd 0x4014000000000000 0xc000000000000000 => f64:0x4083b80000000000
;; run: chainmul 0x0000000000000000 0x0000000000000000 => f64:0x0000000000000000
;; run: chainmul 0x4000000000000000 0x4008000000000000 => f64:0x4073b00000000000
;; run: chainmul 0xc008000000000000 0x401c000000000000 => f64:0xc073b00000000000
;; run: chainmul 0x4014000000000000 0xc000000000000000 => f64:0xc078600000000000
;; run: chainsub 0x0000000000000000 0x0000000000000000 => f64:0xc020000000000000
;; run: chainsub 0x4000000000000000 0x4008000000000000 => f64:0x4014000000000000
;; run: chainsub 0xc008000000000000 0x401c000000000000 => f64:0x4050800000000000
;; run: chainsub 0x4014000000000000 0xc000000000000000 => f64:0x4083580000000000


    (local.set $x (i32.xor (local.get $x) (i32.shr_u (local.get $x) (i32.const 5))))
    (i32.add (local.get $x) (struct.get $leaf 2 (ref.cast (ref $leaf) (local.get $o)))))
  (func $c_link (param $p (ref null $rec)) (param $q (ref null $rec)) (param $x i32) (result i32)
    (if (ref.is_null (local.get $p)) (then (return (call $slow (local.get $x) (i32.const 1)))))

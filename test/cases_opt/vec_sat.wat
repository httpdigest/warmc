(module
  (memory 1)
  ;; A and B, a thousand bytes each, by a generator of the seed; A starts
  ;; with the halfwords at the ends of their range
  (func $fill (param $x i32)
    (local $i i32)
    (loop $l
      (local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1664525)) (i32.const 1013904223)))
      (i32.store8 (i32.add (i32.const 1024) (local.get $i)) (i32.shr_u (local.get $x) (i32.const 13)))
      (i32.store8 (i32.add (i32.const 5120) (local.get $i)) (i32.shr_u (local.get $x) (i32.const 21)))
      (i32.store8 (i32.add (i32.const 9216) (local.get $i)) (i32.const 0x5a))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 1024))))
    (i64.store (i32.const 1024) (i64.const -281472829194241))
    (i64.store (i32.const 1032) (i64.const 4611826762358063105)))
  ;; the three, hashed
  (func $sum (result i64)
    (local $i i32) (local $h i64)
    (loop $l
      (local.set $h (i64.xor (i64.mul (local.get $h) (i64.const 1099511628211))
                             (i64.load8_u (i32.add (i32.const 1024) (local.get $i)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 9216))))
    (local.get $h))
  (func $tone (export "tone") (param $n i32) (param $q i32) (result i64)
    (local $i i32) (local $t i32) (local $u i32) (local $p i64) (local $g i64)
    (call $fill (local.get $q))
    (block $done
      (loop $l
        (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
          (local.set $t (i32.add (i32.load8_u (i32.add (i32.const 1024) (local.get $i))) (i32.and (local.get $q) (i32.const 255))))
          (local.set $t (select (local.get $t) (i32.const 255) (i32.lt_u (local.get $t) (i32.const 255))))
          (local.set $u (i32.sub (local.get $t) (i32.and (i32.shr_u (local.get $q) (i32.const 8)) (i32.const 255))))
          (local.set $u (select (i32.const 0) (local.get $u) (i32.gt_u (local.get $u) (local.get $t))))
          (local.set $t (i32.shl (local.get $u) (i32.const 24)))
          (local.set $u (i32.shl (local.get $t) (i32.shr_u (local.get $q) (i32.const 16))))
          (i32.store8 (i32.add (i32.const 1024) (local.get $i))
            (i32.shr_u (select (i32.const -1) (local.get $u)
                               (i32.ne (local.get $t) (i32.shr_u (local.get $u) (i32.shr_u (local.get $q) (i32.const 16)))))
                       (i32.const 24)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $l)))
    (call $sum))
  (func $shl16 (export "shl16") (param $n i32) (param $q i32) (result i64)

;; The vectoriser's copies: a vector loop of R copies of the body, each U
;; iterations of the scalar loop sixteen bytes apart, one accumulator per
;; copy combined after the loop, a loop of one copy for the vectors the
;; copies leave, and an exit that goes past the scalar loop when the count
;; leaves nothing for it (vectorize_one in src/opt.c).  The back end pairs
;; the copies' loads and stores into ldp/stp of q registers and folds a
;; second widening of a sum into uadalp (isel.c, isel_ops.inc).
;;
;; Every kernel is driven over every length from 0 to 70 and then 127-129,
;; 255-257 and 999-1000, so each of these runs somewhere:
;;   * no vector at all (fewer than U iterations), the one-copy loop alone
;;     (fewer than R vectors), the copies and then 1..R-1 single vectors,
;;     and the copies alone;
;;   * a count that is a multiple of U (the exit goes past the scalar loop)
;;     and one that is not (the scalar loop finishes);
;; and a canary after each output shows a vector that went past the end.
;; The kernels:
;;   * add32, add8, add64, addf32, mul3f64: elementwise, lanes of every width;
;;   * mul3add/mul7h/mul9b: a multiply strength reduction made a shift and an
;;     add or subtract of, made a vector multiply again, in lanes of 32, 16
;;     and 8 bits; shlv: a left shift by an amount the loop does not change,
;;     a multiply by its power of two; shrv and shlvb, a right shift and a
;;     shift of bytes, which stay shifts;
;;   * red32: a sum, a xor, an or and an and in one loop (four reductions,
;;     each its own accumulator per copy); smin/umax: min and max by select;
;;   * fmin32/fmax64: float min and max over values with NaNs, -0 and +0
;;     (a NaN result is hashed as the canonical NaN: its sign is the
;;     implementation's, and x64's vector min sets it where the scalar loop
;;     passes the input's through);
;;   * wsum8u/wsum8s/wsum16u/wsum32u/wsum32s: widening sums, one and two
;;     steps wide (the second fused into uadalp), signed and unsigned;
;;   * count: a sum of compare results (the counted-mask form);
;;   * revsum/revmul: backward, a reduction and an elementwise store;
;;   * pairs/pairsrev: an interleaved group (two loads a lane) with copies,
;;     forward and backward; pairs_alias, its output placed at every 16 bytes
;;     past its input -- the guard used to measure an interleaved group as
;;     reaching one vector an iteration, half its extent, and backward
;;     started its vectors that half too high, both wrong answers before;
;;   * add_alias: the output through a pointer of its own, near the input on
;;     either side, which the guard has to see as overlapping every copy;
;;   * fwd4/fwd8/fwd16: a[i+d] = a[i] + 1, a store d elements ahead of the
;;     load through the same pointer -- the copies' loads come before their
;;     stores, so the copies must stop at d/4 vectors (4: none, 8: two);
;;   * condst: a store under a condition (old values kept by mask);
;;   * unr4: LLVM's unrolled form, four elements an iteration (U = 1);
;;   * lastv/lasti/merged: what the loop hands on past itself -- a value it
;;     loaded (no exit past the scalar loop), its counter, and an exit block
;;     with a second way in;
;;   * const20/const12: constant counts too short for four copies.
(module
  (memory 1)
  (global $base (mut i32) (i32.const 256))
  (data (i32.const 0) "\7f\00\00\00\80\00\00\00\81\00\00\00\ff\00\00\00\00\01\00\00\01\01\00\00\e7\03\00\00\e8\03\00\00")

  ;; m = 0..70 is the length itself, 71..78 the longer ones from the table
  (func $len (param $m i32) (result i32)
    (if (result i32) (i32.lt_u (local.get $m) (i32.const 71))
      (then (local.get $m))
      (else (i32.load (i32.shl (i32.sub (local.get $m) (i32.const 71)) (i32.const 2))))))

  (func $fill (param $p i32) (param $nbytes i32) (param $seed i32)
    (local $j i32) (local $x i32)
    (local.set $x (local.get $seed))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $j) (local.get $nbytes)))
      (local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1103515245)) (i32.const 12345)))
      (i32.store8 (i32.add (local.get $p) (local.get $j)) (i32.shr_u (local.get $x) (i32.const 16)))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l))))

  (func $canary (param $p i32) (param $nbytes i32)
    (local $j i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $j) (local.get $nbytes)))
      (i32.store8 (i32.add (local.get $p) (local.get $j)) (i32.const 0x5a))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l))))

  ;; a hash of nbytes at p, as words
  (func $hash (param $p i32) (param $nbytes i32) (result i32)
    (local $j i32) (local $h i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $j) (local.get $nbytes)))
      (local.set $h (i32.add (i32.mul (local.get $h) (i32.const 31))
                             (i32.load (i32.add (local.get $p) (local.get $j)))))
      (local.set $j (i32.add (local.get $j) (i32.const 4)))
      (br $l)))
    (local.get $h))

  ;; floats with NaNs, both zeros and infinities among them
  (func $fillf32 (param $p i32) (param $n i32) (param $seed i32)
    (local $j i32) (local $x i32) (local $v f32)
    (local.set $x (local.get $seed))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1103515245)) (i32.const 12345)))
      (local.set $v (f32.convert_i32_s (i32.shr_s (local.get $x) (i32.const 20))))
      (if (i32.eq (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 63)) (i32.const 7))
        (then (local.set $v (f32.const nan))))
      (if (i32.eq (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 63)) (i32.const 9))
        (then (local.set $v (f32.const -0))))
      (if (i32.eq (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 63)) (i32.const 11))
        (then (local.set $v (f32.const 0))))
      (f32.store (i32.add (local.get $p) (i32.shl (local.get $j) (i32.const 2))) (local.get $v))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l))))
  (func $fillf64 (param $p i32) (param $n i32) (param $seed i32)
    (local $j i32) (local $x i32) (local $v f64)
    (local.set $x (local.get $seed))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $j) (local.get $n)))
      (local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1103515245)) (i32.const 12345)))
      (local.set $v (f64.convert_i32_s (i32.shr_s (local.get $x) (i32.const 20))))
      (if (i32.eq (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 63)) (i32.const 7))
        (then (local.set $v (f64.const nan))))
      (if (i32.eq (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 63)) (i32.const 9))
        (then (local.set $v (f64.const -0))))
      (if (i32.eq (i32.and (i32.shr_u (local.get $x) (i32.const 8)) (i32.const 63)) (i32.const 13))
        (then (local.set $v (f64.const inf))))
      (f64.store (i32.add (local.get $p) (i32.shl (local.get $j) (i32.const 3))) (local.get $v))
      (local.set $j (i32.add (local.get $j) (i32.const 1)))
      (br $l))))
  (func $add32 (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (i32.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 2)))
        (i32.add (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (i32.load (i32.add (local.get $b) (i32.shl (local.get $i) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $add8 (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (i32.store8 (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 0)))
        (i32.add (i32.load8_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 0)))) (i32.load8_u (i32.add (local.get $b) (i32.shl (local.get $i) (i32.const 0))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $add64 (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (i64.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 3)))
        (i64.add (i64.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 3)))) (i64.load (i32.add (local.get $b) (i32.shl (local.get $i) (i32.const 3))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $addf32 (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (f32.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 2)))
        (f32.add (f32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (f32.load (i32.add (local.get $b) (i32.shl (local.get $i) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $mul3f64 (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (f64.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 3)))
        (f64.mul (f64.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 3)))) (f64.const 3)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $mul3add (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (i32.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 2)))
        (i32.add (i32.mul (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 3)) (i32.const 7)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $mul7h (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (i32.store16 (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 1)))
        (i32.mul (i32.load16_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 1)))) (i32.const 7)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $mul9b (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (loop $l
      (i32.store8 (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 0)))
        (i32.mul (i32.load8_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 0)))) (i32.const 9)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $shlv (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32) (local $k i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (local.set $k (i32.load (local.get $b)))
    (loop $l
      (i32.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 2)))
        (i32.shl (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (local.get $k)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $shrv (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32) (local $k i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (local.set $k (i32.load (local.get $b)))
    (loop $l
      (i32.store (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 2)))
        (i32.shr_u (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (local.get $k)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $shlvb (param $a i32) (param $b i32) (param $c i32) (param $n i32)
    (local $i i32) (local $k i32)
    (if (i32.eqz (local.get $n)) (then (return)))
    (local.set $k (i32.load (local.get $b)))
    (loop $l
      (i32.store8 (i32.add (local.get $c) (i32.shl (local.get $i) (i32.const 0)))
        (i32.shl (i32.load8_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 0)))) (local.get $k)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
  (func $smin (param $a i32) (param $n i32) (result i32)
    (local $i i32) (local $s i32)
    (local.set $s (i32.const 0x7fffffff))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (select (local.get $s) (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (i32.lt_s (local.get $s) (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $umax (param $a i32) (param $n i32) (result i32)
    (local $i i32) (local $s i32)
    (local.set $s (i32.const 0))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (select (local.get $s) (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (i32.gt_u (local.get $s) (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $fmin32 (param $a i32) (param $n i32) (result f32)
    (local $i i32) (local $s f32)
    (local.set $s (f32.const inf))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (f32.min (local.get $s) (f32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $fmax64 (param $a i32) (param $n i32) (result f64)
    (local $i i32) (local $s f64)
    (local.set $s (f64.const -inf))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (f64.max (local.get $s) (f64.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 3))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $wsum8u (param $a i32) (param $n i32) (result i32)
    (local $i i32) (local $s i32)
    (local.set $s (i32.const 0))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (i32.add (local.get $s) (i32.load8_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 0))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $wsum8s (param $a i32) (param $n i32) (result i32)
    (local $i i32) (local $s i32)
    (local.set $s (i32.const 7))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (i32.add (local.get $s) (i32.load8_s (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 0))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $wsum16u (param $a i32) (param $n i32) (result i64)
    (local $i i32) (local $s i64)
    (local.set $s (i64.const 0))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (i64.add (local.get $s) (i64.load16_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 1))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $wsum32u (param $a i32) (param $n i32) (result i64)
    (local $i i32) (local $s i64)
    (local.set $s (i64.const 0))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (i64.add (local.get $s) (i64.load32_u (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $wsum32s (param $a i32) (param $n i32) (result i64)
    (local $i i32) (local $s i64)
    (local.set $s (i64.const -5))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (i64.add (local.get $s) (i64.load32_s (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $count (param $a i32) (param $n i32) (result i32)
    (local $i i32) (local $s i32)
    (local.set $s (i32.const 0))
    (if (i32.eqz (local.get $n)) (then (return (local.get $s))))
    (loop $l
      (local.set $s (i32.add (local.get $s) (i32.gt_s (i32.load (i32.add (local.get $a) (i32.shl (local.get $i) (i32.const 2)))) (i32.const 100))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $s))
  (func $red32 (param $a i32) (param $n i32) (result i32)
    (local $i i32) (local $s i32) (local $x i32) (local $o i32) (local $d i32)
    (local.set $d (i32.const -1))
    (if (i32.eqz (local.get $n)) (then (return (i32.const 0))))
    (loop $l

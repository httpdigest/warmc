(module
  (memory 1 4)
  (data (i32.const 0) "\01\02\03\04\05\06\07\08\ff\fe\fd\fc\80\7f\00\11")
  (data (i32.const 100) "hello, world")
  (data "passive-segment-payload")

  (global $g0 (mut i32) (i32.const 7))
  (global $g1 (mut i64) (i64.const -1))
  (global $g2 (mut f64) (f64.const 2.5))
  (global $g3 i32 (i32.const 1234))

  (func $store_all
    (i32.store    (i32.const 200) (i32.const 0x11223344))
    (i64.store    (i32.const 208) (i64.const 0x8877665544332211))
    (f32.store    (i32.const 216) (f32.const 1.5))
    (f64.store    (i32.const 224) (f64.const -3.25))
    (i32.store8   (i32.const 232) (i32.const 0xAABBCCDD))
    (i32.store16  (i32.const 234) (i32.const 0xAABBCCDD))
    (i64.store8   (i32.const 236) (i64.const 0x99))
    (i64.store16  (i32.const 238) (i64.const 0x1234))
    (i64.store32  (i32.const 240) (i64.const 0xDEADBEEF)))

  ;; ---- loads from the data segment ----
  (func (export "l8u_0")  (result i32) (i32.load8_u  (i32.const 0)))
  (func (export "l8s_8")  (result i32) (i32.load8_s  (i32.const 8)))
  (func (export "l8u_8")  (result i32) (i32.load8_u  (i32.const 8)))
  (func (export "l8s_12") (result i32) (i32.load8_s  (i32.const 12)))
  (func (export "l8s_13") (result i32) (i32.load8_s  (i32.const 13)))
  (func (export "l16s_8") (result i32) (i32.load16_s (i32.const 8)))
  (func (export "l16u_8") (result i32) (i32.load16_u (i32.const 8)))
  (func (export "l32_0")  (result i32) (i32.load     (i32.const 0)))
  (func (export "l32_4")  (result i32) (i32.load     (i32.const 4)))
  (func (export "l64_0")  (result i64) (i64.load     (i32.const 0)))
  (func (export "l64_8")  (result i64) (i64.load     (i32.const 8)))
  (func (export "i64_l8s")  (result i64) (i64.load8_s  (i32.const 8)))
  (func (export "i64_l8u")  (result i64) (i64.load8_u  (i32.const 8)))
  (func (export "i64_l16s") (result i64) (i64.load16_s (i32.const 8)))
  (func (export "i64_l16u") (result i64) (i64.load16_u (i32.const 8)))
  (func (export "i64_l32s") (result i64) (i64.load32_s (i32.const 8)))
  (func (export "i64_l32u") (result i64) (i64.load32_u (i32.const 8)))

  ;; static offsets, including large ones
  (func (export "off_a") (result i32) (i32.load offset=4 (i32.const 0)))
  (func (export "off_b") (result i32) (i32.load offset=100 (i32.const 4)))
  (func (export "off_c") (result i32) (i32.load offset=4096 (i32.const 0)))
  (func (export "off_d") (result i32) (i32.load offset=65532 (i32.const 0)))
  (func (export "off_dyn") (result i32)
    (local $p i32)
    (local.set $p (i32.const 96))
    (i32.load offset=8 (local.get $p)))

  ;; unaligned accesses
  (func (export "unal_a") (result i32) (i32.load align=1 (i32.const 1)))
  (func (export "unal_b") (result i64) (i64.load align=1 (i32.const 3)))

  ;; ---- stores read back ----
  (func (export "st_i32")  (result i32) (call $store_all) (i32.load (i32.const 200)))
  (func (export "st_i64")  (result i64) (call $store_all) (i64.load (i32.const 208)))
  (func (export "st_f32")  (result i32) (call $store_all) (i32.load (i32.const 216)))
  (func (export "st_f64")  (result i64) (call $store_all) (i64.load (i32.const 224)))
  (func (export "st_b")    (result i32) (call $store_all) (i32.load8_u (i32.const 232)))
  (func (export "st_h")    (result i32) (call $store_all) (i32.load16_u (i32.const 234)))
  (func (export "st_i64b") (result i32) (call $store_all) (i32.load8_u (i32.const 236)))
  (func (export "st_i64h") (result i32) (call $store_all) (i32.load16_u (i32.const 238)))
  (func (export "st_i64w") (result i32) (call $store_all) (i32.load (i32.const 240)))

  ;; ---- store-to-load forwarding, in one block so the optimiser sees it ----
  ;; A narrowing store wrote fewer bytes than its value has, and a
  ;; sign-extended narrow load is not the same value as a zero-extended one.
  ;; Addresses here are away from everything else, because the reference
  ;; interpreter runs every export against one instance.
  (func (export "fwd_st8") (result i32)
    (i32.store8 (i32.const 700) (i32.const 0xAABBCCDD))
    (i32.load8_u (i32.const 700)))
  (func (export "fwd_st16") (result i32)
    (i32.store16 (i32.const 704) (i32.const 0xAABBCCDD))
    (i32.load16_u (i32.const 704)))
  (func (export "fwd_st32") (result i64)
    (i64.store32 (i32.const 708) (i64.const 0x1122334455667788))
    (i64.load32_u (i32.const 708)))
  (func (export "fwd_sgn_su") (result i32)
    (i32.store8 (i32.const 712) (i32.const 0x80))
    (i32.sub (i32.load8_s (i32.const 712)) (i32.load8_u (i32.const 712))))
  (func (export "fwd_sgn_us") (result i32)
    (i32.store8 (i32.const 716) (i32.const 0x80))
    (i32.sub (i32.load8_u (i32.const 716)) (i32.load8_s (i32.const 716))))
  ;; Distinct slots off one base: forwarding has to survive the neighbours.
  (func (export "fwd_slots") (result i32)
    (i32.store (i32.const 720) (i32.const 11))
    (i32.store (i32.const 724) (i32.const 22))
    (i32.store (i32.const 728) (i32.const 33))
    (i32.add (i32.load (i32.const 720))
             (i32.add (i32.load (i32.const 724)) (i32.load (i32.const 728)))))
  ;; Overlapping ones must not.
  (func (export "fwd_overlap") (result i32)
    (i32.store (i32.const 736) (i32.const 0x11223344))
    (i32.store8 (i32.const 737) (i32.const 0xFF))
    (i32.load (i32.const 736)))
  (func (export "fwd_overlap_dyn") (param) (result i64)
    (local $p i32)
    (local.set $p (i32.const 744))
    (i64.store (local.get $p) (i64.const 0x0102030405060708))
    (i32.store16 offset=2 (local.get $p) (i32.const 0xFFFF))
    (i64.load (local.get $p)))

  ;; ---- globals ----
  (func (export "g_read")  (result i32) (global.get $g0))
  (func (export "g_const") (result i32) (global.get $g3))
  (func (export "g_i64")   (result i64) (global.get $g1))
  (func (export "g_f64")   (result i64) (i64.reinterpret_f64 (global.get $g2)))
  (func (export "g_write") (result i32)
    (global.set $g0 (i32.const 99))
    (global.set $g0 (i32.add (global.get $g0) (i32.const 1)))
    (global.get $g0))

  ;; ---- size and growth ----
  (func (export "size0") (result i32) (memory.size))
  (func (export "grow1") (result i32)
    (drop (memory.grow (i32.const 1)))
    (memory.size))
  (func (export "grow_too_much") (result i32) (memory.grow (i32.const 100)))
  (func (export "grow_then_store") (result i32)
    (drop (memory.grow (i32.const 1)))
    (i32.store (i32.const 70000) (i32.const 0x5A5A5A5A))
    (i32.load (i32.const 70000)))

  ;; ---- bulk memory ----
  (func (export "fill") (result i64)
    (memory.fill (i32.const 300) (i32.const 0xAB) (i32.const 8))
    (i64.load (i32.const 300)))
  (func (export "copy") (result i64)
    (memory.fill (i32.const 400) (i32.const 0) (i32.const 16))
    (memory.copy (i32.const 400) (i32.const 0) (i32.const 8))
    (i64.load (i32.const 400)))
  (func (export "copy_overlap") (result i64)
    (i64.store (i32.const 500) (i64.const 0x0102030405060708))
    (memory.copy (i32.const 502) (i32.const 500) (i32.const 6))
    (i64.load (i32.const 500)))
  (func (export "init") (result i64)
    (memory.init 2 (i32.const 600) (i32.const 0) (i32.const 8))
    (i64.load (i32.const 600)))
)

;; Store-to-load forwarding and the stores it lets go (pass_memopt), on the
;; shapes that reach its edges:
;;
;;   * an entry a signed narrow load made, overwritten by a store whose value
;;     fits the byte: a later signed load must sign-extend the byte, not see
;;     the stored value.  This once read back 200 for a byte of 200.
;;   * a float stored and its bits loaded back, and the other way round, as
;;     Go's math.Float64bits and Float32frombits leave them, including an i64
;;     stored as 4 bytes, whose high half nothing knows, and a 4-byte load
;;     sign- or zero-extended to i64.
;;   * a store of a value just loaded from the same slot writes nothing new
;;     and goes, unless something that may be the same slot was written in
;;     between, or the store is wider than the load.
;;   * more slots than the table holds, then a store through another pointer
;;     to one of them, then all of them again.
;;   * a loop each of whose iterations reads what the one before wrote, which
;;     after unrolling is forwarding between the copies of the body.
;;
;; Every value comes from a mutable global so nothing folds it away first.

(module
  (memory 1)
  (global $n (export "n") (mut i32) (i32.const -7))
  (global $bits (export "bits") (mut i64) (i64.const 0xc00c_0000_0000_0001))
  (global $wide (export "wide") (mut i64) (i64.const 0x1234_5678_bfc0_0000))
  (global $p (export "p") (mut i32) (i32.const 1200))
  (global $q (export "q") (mut i32) (i32.const 1200))
  (global $base (export "base") (mut i32) (i32.const 2048))
  (data (i32.const 1200) "\05\00\00\00\81\82\83\84")

  (func (export "signed_entry_overwritten") (result i32)
    (local $a i32)
    (local.set $a (i32.load8_s (i32.const 800)))
    (i32.store8 (i32.const 800) (i32.const 200))
    (i32.add (local.get $a) (i32.load8_s (i32.const 800))))

  (func (export "f64_bits") (result i64)
    (f64.store (i32.const 1024) (f64.div (f64.convert_i32_s (global.get $n)) (f64.const 3)))
    (i64.load (i32.const 1024)))

  (func (export "f64_from_bits") (result f64)
    (i64.store (i32.const 1032) (i64.add (global.get $bits) (i64.const 1)))
    (f64.load (i32.const 1032)))

  (func (export "f32_bits_widened") (result i64)
    (f32.store (i32.const 1040) (f32.div (f32.convert_i32_s (global.get $n)) (f32.const 2)))
    (i64.add (i64.load32_u (i32.const 1040))
             (i64.mul (i64.load32_s (i32.const 1040)) (i64.const 3))))

  (func (export "f32_from_low_half") (result f32)
    (i64.store32 (i32.const 1048) (global.get $wide))
    (f32.load (i32.const 1048)))

  (func (export "low_half_read_back") (result i64)
    (i64.store32 (i32.const 1056) (global.get $wide))
    (i64.add (i64.extend_i32_u (i32.load (i32.const 1056)))
             (i64.add (i64.mul (i64.load32_s (i32.const 1056)) (i64.const 5))
                      (i64.mul (i64.load32_u (i32.const 1056)) (i64.const 7)))))

  (func (export "i32_as_f32_and_i64") (result i64)
    (local $f f32)
    (i32.store (i32.const 1064) (i32.mul (global.get $n) (i32.const 0x0101_0101)))
    (local.set $f (f32.load (i32.const 1064)))
    (i64.add (i64.load32_s (i32.const 1064))
             (i64.extend_i32_u (i32.reinterpret_f32 (local.get $f)))))

  (func (export "store_back_after_aliasing_store") (result i32)
    (local $v i32)
    (local.set $v (i32.load (global.get $p)))
    (i32.store (global.get $q) (i32.const 77))
    (i32.store (global.get $p) (local.get $v))
    (i32.load (global.get $q)))

  (func (export "store_back_same_slot") (result i32)
    (local $v i32)
    (local.set $v (i32.load offset=4 (global.get $p)))
    (i32.store offset=4 (global.get $p) (local.get $v))
    (i32.load offset=4 (global.get $q)))

  (func (export "store_back_same_byte") (result i32)
    (local $v i32)
    (local.set $v (i32.load8_s offset=6 (global.get $p)))
    (i32.store8 offset=6 (global.get $p) (local.get $v))
    (i32.load offset=4 (global.get $q)))

  (func (export "store_back_wider") (result i32)
    (local $v i32)
    (local.set $v (i32.load8_s offset=4 (global.get $p)))
    (i32.store16 offset=4 (global.get $p) (local.get $v))
    (i32.load offset=4 (global.get $q)))

  (func (export "many_slots") (result i32)
    (local $acc i32) (local $p i32) (local $i i32)
    (local.set $p (global.get $base))
    (loop $fill
      (i32.store (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2)))
                 (i32.add (i32.mul (local.get $i) (i32.const 7)) (i32.const 1)))
      (br_if $fill (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1)))
                             (i32.const 70))))
    (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 3)) (i32.load offset=0 (local.get $p))))
    (local.set $acc (i32.add (i32.mul (local.get $acc) (i32.const 3)) (i32.load offset=4 (local.get $p))))

    (local.set $end (i32.mul (memory.size) (i32.const 65536)))
    (call $seed (i32.sub (local.get $end) (i32.const 2000)) (local.get $end))
    ;; 100, 1500, 0, 65
    (local.set $n (i32.load (i32.const 96)))
    (memory.fill (i32.sub (local.get $end) (local.get $n)) (i32.const 0x3c) (local.get $n))
    (local.set $n (i32.load (i32.const 104)))
    (memory.copy (i32.sub (local.get $end) (local.get $n))
                 (i32.sub (i32.sub (local.get $end) (local.get $n)) (i32.const 300))
                 (local.get $n))
    (local.set $n (i32.load (i32.const 64)))
    (memory.copy (local.get $end) (local.get $end) (local.get $n))
    (memory.fill (local.get $end) (i32.const 1) (local.get $n))
    (local.set $n (i32.load (i32.const 92)))
    (memory.copy (i32.sub (local.get $end) (i32.const 300))
                 (i32.sub (local.get $end) (local.get $n))
                 (local.get $n))
    (local.set $a (i32.sub (local.get $end) (i32.const 2000)))
    (loop $l
      (local.set $h (i64.add (i64.mul (local.get $h) (i64.const 31))
                             (i64.load8_u (local.get $a))))
      (br_if $l (i32.lt_u (local.tee $a (i32.add (local.get $a) (i32.const 1)))
                          (local.get $end))))
    (local.get $h))
)

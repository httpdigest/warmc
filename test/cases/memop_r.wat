;; memory.copy and memory.fill of memory 0 on AArch64 are no call to the
;; register allocator (regalloc.inc memop_preserves): a constant length up
;; to 96 bytes is made inline in v26-v31, a variable one up to 16 inline as
;; smallmemop.wat's, and any other is a bl of warmc_memmove_r or
;; warmc_memset_r (rt/start.S), which touch only x12-x17, v26-v31 and the
;; flags, so a value live across the op stays in whatever register it has.
;; Elsewhere they are calls as before.  What can go wrong, one export group
;; each:
;;
;;   * The routines' shapes: every length from 0 to 300 -- the 1, 2, 4 and
;;     8-byte pairs, the q pairs up to 64, the 64-byte loop and the 32 or 64
;;     bytes left after it -- at shifts that overlap the source by one byte,
;;     by all but one, and by the q and loop sizes either way, that start at
;;     the source, and that miss it, at sixteen alignments.  Each case seeds
;;     a window round both ranges, makes the op, and counts the bytes that
;;     differ from what a memmove leaves there: the answer's high half is
;;     that count, 0, and its low half the number of cases made.
;;   * The same at lengths round where Darwin's routines hand over to
;;     libSystem (65536 for a copy, 1024 for a fill).
;;   * Values live across the ops in every kind of register -- i32, i64, f64
;;     and v128, more of them than the callee-saved registers hold -- over
;;     every path: inline, the routines' short shapes and loops, and
;;     libSystem's, which must find each register the compiler may keep a
;;     value in saved.  Only adds and integer multiplies, so -O3's fused
;;     multiply-add changes nothing.
;;   * The memory's base kept for the routine in a function that reads
;;     memory no other way.
;;   * The memory's size read when the op runs: after a memory.grow, ops
;;     ending at the new last byte, and empty ones at the end itself.

(module
  (memory 4)
  ;; the shifts every length is copied at, besides those by its own length
  (data (i32.const 0) "\01\07\08\09\0f\10\11\1f\20\21\3f\40\41")
  ;; the lengths $keep cycles through
  (data (i32.const 64) "\00\00\00\00\01\00\00\00\05\00\00\00\10\00\00\00\11\00\00\00\21\00\00\00\40\00\00\00\41\00\00\00\64\00\00\00\c8\00\00\00\dc\05\00\00\00\10\00\00\00\00\01\00\70\11\01\00")

  ;; what the byte at a holds before an op: a hash of a
  (func $f (param $a i32) (result i32)
    (i32.shr_u (i32.mul (local.get $a) (i32.const 0x9e3779b1)) (i32.const 24)))

  (func $seed (param $lo i32) (param $hi i32)
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $lo) (local.get $hi)))
      (i32.store8 (local.get $lo) (call $f (local.get $lo)))
      (local.set $lo (i32.add (local.get $lo) (i32.const 1)))
      (br $l))))

  ;; how many bytes of [min - 16, max + n + 16) differ from a memmove's
  (func $copy_case (param $d i32) (param $s i32) (param $n i32) (result i32)
    (local $lo i32) (local $hi i32) (local $a i32) (local $bad i32)
    (local.set $lo (i32.sub (select (local.get $d) (local.get $s)
                                    (i32.lt_u (local.get $d) (local.get $s)))
                            (i32.const 16)))
    (local.set $hi (i32.add (i32.add (select (local.get $d) (local.get $s)
                                             (i32.gt_u (local.get $d) (local.get $s)))
                                     (local.get $n))
                            (i32.const 16)))
    (call $seed (local.get $lo) (local.get $hi))
    (memory.copy (local.get $d) (local.get $s) (local.get $n))
    (local.set $a (local.get $lo))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $a) (local.get $hi)))
      (local.set $bad
        (i32.add (local.get $bad)
          (i32.ne (i32.load8_u (local.get $a))
                  (call $f (select (i32.add (i32.sub (local.get $a) (local.get $d)) (local.get $s))
                                   (local.get $a)
                                   (i32.lt_u (i32.sub (local.get $a) (local.get $d))
                                             (local.get $n)))))))
      (local.set $a (i32.add (local.get $a) (i32.const 1)))
      (br $l)))
    (local.get $bad))

  ;; how many bytes of [d - 16, d + n + 16) differ from a fill's
  (func $fill_case (param $d i32) (param $v i32) (param $n i32) (result i32)
    (local $hi i32) (local $a i32) (local $bad i32)
    (local.set $a (i32.sub (local.get $d) (i32.const 16)))
    (local.set $hi (i32.add (i32.add (local.get $d) (local.get $n)) (i32.const 16)))
    (call $seed (local.get $a) (local.get $hi))
    (memory.fill (local.get $d) (local.get $v) (local.get $n))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $a) (local.get $hi)))
      (local.set $bad
        (i32.add (local.get $bad)
          (i32.ne (i32.load8_u (local.get $a))
                  (select (i32.and (local.get $v) (i32.const 255))
                          (call $f (local.get $a))
                          (i32.lt_u (i32.sub (local.get $a) (local.get $d))
                                    (local.get $n))))))
      (local.set $a (i32.add (local.get $a) (i32.const 1)))
      (br $l)))
    (local.get $bad))

  ;; shift k of length n: the table's 13 forwards, its 13 backwards, none,
  ;; and -(n + 1), -n, 1 - n, n - 1, n and n + 1
  (func $shift (param $k i32) (param $n i32) (result i32)
    (block $byn
      (if (i32.lt_u (local.get $k) (i32.const 13))
        (then (return (i32.load8_u (local.get $k)))))
      (if (i32.lt_u (local.get $k) (i32.const 26))
        (then (return (i32.sub (i32.const 0)
                               (i32.load8_u (i32.sub (local.get $k) (i32.const 13)))))))
      (br_if $byn (i32.ne (local.get $k) (i32.const 26)))
      (return (i32.const 0)))
    (local.set $k (i32.sub (local.get $k) (i32.const 27)))
    (if (result i32) (i32.lt_u (local.get $k) (i32.const 3))
      (then (i32.sub (i32.sub (i32.const -1) (local.get $n))
                     (i32.sub (i32.const 0) (local.get $k))))
      (else (i32.add (i32.sub (local.get $n) (i32.const 1))
                     (i32.sub (local.get $k) (i32.const 3))))))

  ;; every length in [n, last], each at the 33 shifts from a source whose
  ;; alignment the length picks
  (func $sweep_copy (param $n i32) (param $last i32) (result i64)
    (local $k i32) (local $s i32) (local $bad i32) (local $cases i32)
    (block $done (loop $ln
      (br_if $done (i32.gt_u (local.get $n) (local.get $last)))
      (local.set $s (i32.add (i32.const 2048)
                             (i32.and (i32.mul (local.get $n) (i32.const 5)) (i32.const 15))))
      (local.set $k (i32.const 0))
      (loop $lk
        (local.set $bad
          (i32.add (local.get $bad)
            (call $copy_case (i32.add (local.get $s) (call $shift (local.get $k) (local.get $n)))
                             (local.get $s) (local.get $n))))
        (local.set $cases (i32.add (local.get $cases) (i32.const 1)))
        (br_if $lk (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1)))
                             (i32.const 33))))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br $ln)))
    (i64.or (i64.shl (i64.extend_i32_u (local.get $bad)) (i64.const 32))
            (i64.extend_i32_u (local.get $cases))))

  (func (export "copy_lengths_0_to_99") (result i64)
    (call $sweep_copy (i32.const 0) (i32.const 99)))
  (func (export "copy_lengths_100_to_199") (result i64)
    (call $sweep_copy (i32.const 100) (i32.const 199)))
  (func (export "copy_lengths_200_to_300") (result i64)
    (call $sweep_copy (i32.const 200) (i32.const 300)))

  ;; length n at eight shifts -- by one byte and by all but one either
  ;; way, and to just past its end or one byte further either way -- or,
  ;; with more, at all 33
  (func $copy_long (param $n i32) (param $more i32) (result i64)
    (local $s i32) (local $bad i32) (local $cases i32) (local $k i32)
    (local.set $s (i32.add (i32.const 70000) (i32.and (local.get $n) (i32.const 15))))
    (loop $lk
      (if (i32.or (local.get $more)
                  (i32.or (i32.ge_u (local.get $k) (i32.const 27))
                          (i32.or (i32.eqz (local.get $k)) (i32.eq (local.get $k) (i32.const 13)))))
        (then
          (local.set $bad
            (i32.add (local.get $bad)
              (call $copy_case (i32.add (local.get $s) (call $shift (local.get $k) (local.get $n)))
                               (local.get $s) (local.get $n))))
          (local.set $cases (i32.add (local.get $cases) (i32.const 1)))))
      (br_if $lk (i32.lt_u (local.tee $k (i32.add (local.get $k) (i32.const 1)))
                           (i32.const 33))))
    (i64.or (i64.shl (i64.extend_i32_u (local.get $bad)) (i64.const 32))
            (i64.extend_i32_u (local.get $cases))))

  (func (export "copy_long_lengths") (result i64)
    (i64.add
      (i64.add (i64.add (call $copy_long (i32.const 1023) (i32.const 1))
                        (call $copy_long (i32.const 1024) (i32.const 1)))
               (i64.add (call $copy_long (i32.const 1025) (i32.const 1))
                        (call $copy_long (i32.const 4099) (i32.const 1))))
      (i64.add (i64.add (call $copy_long (i32.const 65535) (i32.const 0))
                        (call $copy_long (i32.const 65536) (i32.const 0)))
               (call $copy_long (i32.const 65537) (i32.const 0)))))

  ;; every length in [n, last] at sixteen alignments, each with its own
  ;; byte, given with high bits the fill must not look at
  (func $sweep_fill (param $n i32) (param $last i32) (param $step i32) (result i64)
    (local $al i32) (local $bad i32) (local $cases i32)
    (block $done (loop $ln
      (br_if $done (i32.gt_u (local.get $n) (local.get $last)))
      (local.set $al (i32.const 0))
      (loop $la
        (local.set $bad
          (i32.add (local.get $bad)
            (call $fill_case (i32.add (i32.const 2048) (local.get $al))
                             (i32.add (i32.const 0x1200)
                                      (i32.add (i32.mul (local.get $n) (i32.const 7))
                                               (local.get $al)))
                             (local.get $n))))
        (local.set $cases (i32.add (local.get $cases) (i32.const 1)))
        (br_if $la (i32.lt_u (local.tee $al (i32.add (local.get $al) (local.get $step)))
                             (i32.const 16))))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br $ln)))
    (i64.or (i64.shl (i64.extend_i32_u (local.get $bad)) (i64.const 32))
            (i64.extend_i32_u (local.get $cases))))

  (func (export "fill_lengths_0_to_300") (result i64)
    (call $sweep_fill (i32.const 0) (i32.const 300) (i32.const 1)))
  (func (export "fill_long_lengths") (result i64)
    (i64.add
      (i64.add (call $sweep_fill (i32.const 1023) (i32.const 1025) (i32.const 7))
               (call $sweep_fill (i32.const 4099) (i32.const 4099) (i32.const 7)))
      (call $sweep_fill (i32.const 65535) (i32.const 65537) (i32.const 7))))

  ;; 12 i32, 8 i64, 12 f64 and 6 v128 values carried round a loop whose
  ;; every pass copies and fills at the next of the table's lengths, read
  ;; from memory so that nothing knows it, and at constant lengths of 96 and
  ;; 72 inline; each value is changed before an op and read after it.  The
  ;; bytes it reads it seeds first, whatever the exports before it left
  ;; there.
  (func (export "keep") (result i64)
    (local $i i32) (local $n i32) (local $h i64)
    (local $g0 i32) (local $g1 i32) (local $g2 i32) (local $g3 i32) (local $g4 i32) (local $g5 i32) (local $g6 i32) (local $g7 i32) (local $g8 i32) (local $g9 i32) (local $g10 i32) (local $g11 i32)
    (local $h0 i64) (local $h1 i64) (local $h2 i64) (local $h3 i64) (local $h4 i64) (local $h5 i64) (local $h6 i64) (local $h7 i64)
    (local $f0 f64) (local $f1 f64) (local $f2 f64) (local $f3 f64) (local $f4 f64) (local $f5 f64) (local $f6 f64) (local $f7 f64) (local $f8 f64) (local $f9 f64) (local $f10 f64) (local $f11 f64)
    (local $v0 v128) (local $v1 v128) (local $v2 v128) (local $v3 v128) (local $v4 v128) (local $v5 v128)
    (local.set $g0 (i32.const 7))
    (local.set $g1 (i32.const 4104))
    (local.set $g2 (i32.const 8201))
    (local.set $g3 (i32.const 12298))
    (local.set $g4 (i32.const 16395))
    (local.set $g5 (i32.const 20492))
    (local.set $g6 (i32.const 24589))
    (local.set $g7 (i32.const 28686))
    (local.set $g8 (i32.const 32783))
    (local.set $g9 (i32.const 36880))
    (local.set $g10 (i32.const 40977))
    (local.set $g11 (i32.const 45074))
    (local.set $h0 (i64.const 3))
    (local.set $h1 (i64.const 4294967300))
    (local.set $h2 (i64.const 8589934597))
    (local.set $h3 (i64.const 12884901894))
    (local.set $h4 (i64.const 17179869191))
    (local.set $h5 (i64.const 21474836488))
    (local.set $h6 (i64.const 25769803785))
    (local.set $h7 (i64.const 30064771082))
    (local.set $f0 (f64.const 0.5))
    (local.set $f1 (f64.const 1.5))
    (local.set $f2 (f64.const 2.5))
    (local.set $f3 (f64.const 3.5))
    (local.set $f4 (f64.const 4.5))
    (local.set $f5 (f64.const 5.5))
    (local.set $f6 (f64.const 6.5))
    (local.set $f7 (f64.const 7.5))
    (local.set $f8 (f64.const 8.5))
    (local.set $f9 (f64.const 9.5))
    (local.set $f10 (f64.const 10.5))
    (local.set $f11 (f64.const 11.5))
    (local.set $v0 (v128.const i32x4 0 1 0 1))
    (local.set $v1 (v128.const i32x4 1 2 3 8))
    (local.set $v2 (v128.const i32x4 2 3 6 15))
    (local.set $v3 (v128.const i32x4 3 4 9 22))
    (local.set $v4 (v128.const i32x4 4 5 12 29))
    (local.set $v5 (v128.const i32x4 5 6 15 36))
    (call $seed (i32.const 30000) (i32.const 240200))
    (loop $l
      (local.set $n (i32.load (i32.add (i32.const 64)
                                       (i32.shl (i32.rem_u (local.get $i) (i32.const 14))
                                                (i32.const 2)))))
      (local.set $g0 (i32.add (i32.mul (local.get $g0) (i32.const 3)) (i32.xor (local.get $g1) (local.get $n))))
      (local.set $g1 (i32.add (i32.mul (local.get $g1) (i32.const 5)) (i32.xor (local.get $g2) (local.get $n))))
      (local.set $g2 (i32.add (i32.mul (local.get $g2) (i32.const 7)) (i32.xor (local.get $g3) (local.get $n))))
      (local.set $g3 (i32.add (i32.mul (local.get $g3) (i32.const 9)) (i32.xor (local.get $g4) (local.get $n))))
      (local.set $g4 (i32.add (i32.mul (local.get $g4) (i32.const 11)) (i32.xor (local.get $g5) (local.get $n))))
      (local.set $g5 (i32.add (i32.mul (local.get $g5) (i32.const 13)) (i32.xor (local.get $g6) (local.get $n))))
      (local.set $g6 (i32.add (i32.mul (local.get $g6) (i32.const 15)) (i32.xor (local.get $g7) (local.get $n))))
      (local.set $g7 (i32.add (i32.mul (local.get $g7) (i32.const 17)) (i32.xor (local.get $g8) (local.get $n))))
      (local.set $g8 (i32.add (i32.mul (local.get $g8) (i32.const 19)) (i32.xor (local.get $g9) (local.get $n))))
      (local.set $g9 (i32.add (i32.mul (local.get $g9) (i32.const 21)) (i32.xor (local.get $g10) (local.get $n))))
      (local.set $g10 (i32.add (i32.mul (local.get $g10) (i32.const 23)) (i32.xor (local.get $g11) (local.get $n))))
      (local.set $g11 (i32.add (i32.mul (local.get $g11) (i32.const 25)) (i32.xor (local.get $g0) (local.get $n))))
      (local.set $h0 (i64.add (i64.mul (local.get $h0) (i64.const 5)) (i64.extend_i32_u (local.get $g0))))
      (local.set $h1 (i64.add (i64.mul (local.get $h1) (i64.const 7)) (i64.extend_i32_u (local.get $g1))))
      (local.set $h2 (i64.add (i64.mul (local.get $h2) (i64.const 9)) (i64.extend_i32_u (local.get $g2))))
      (local.set $h3 (i64.add (i64.mul (local.get $h3) (i64.const 11)) (i64.extend_i32_u (local.get $g3))))
      (local.set $h4 (i64.add (i64.mul (local.get $h4) (i64.const 13)) (i64.extend_i32_u (local.get $g4))))
      (local.set $h5 (i64.add (i64.mul (local.get $h5) (i64.const 15)) (i64.extend_i32_u (local.get $g5))))
      (local.set $h6 (i64.add (i64.mul (local.get $h6) (i64.const 17)) (i64.extend_i32_u (local.get $g6))))
      (local.set $h7 (i64.add (i64.mul (local.get $h7) (i64.const 19)) (i64.extend_i32_u (local.get $g7))))
      (local.set $f0 (f64.add (f64.add (local.get $f0) (local.get $f1)) (f64.convert_i32_u (local.get $g0))))
      (local.set $f0 (f64.sub (local.get $f0) (f64.add (local.get $f0) (f64.const 0.25))))
      (local.set $f1 (f64.add (f64.add (local.get $f1) (local.get $f2)) (f64.convert_i32_u (local.get $g1))))
      (local.set $f1 (f64.sub (local.get $f1) (f64.add (local.get $f1) (f64.const 0.25))))
      (local.set $f2 (f64.add (f64.add (local.get $f2) (local.get $f3)) (f64.convert_i32_u (local.get $g2))))
      (local.set $f2 (f64.sub (local.get $f2) (f64.add (local.get $f2) (f64.const 0.25))))
      (local.set $f3 (f64.add (f64.add (local.get $f3) (local.get $f4)) (f64.convert_i32_u (local.get $g3))))
      (local.set $f3 (f64.sub (local.get $f3) (f64.add (local.get $f3) (f64.const 0.25))))
      (local.set $f4 (f64.add (f64.add (local.get $f4) (local.get $f5)) (f64.convert_i32_u (local.get $g4))))
      (local.set $f4 (f64.sub (local.get $f4) (f64.add (local.get $f4) (f64.const 0.25))))
      (local.set $f5 (f64.add (f64.add (local.get $f5) (local.get $f6)) (f64.convert_i32_u (local.get $g5))))
      (local.set $f5 (f64.sub (local.get $f5) (f64.add (local.get $f5) (f64.const 0.25))))
      (local.set $f6 (f64.add (f64.add (local.get $f6) (local.get $f7)) (f64.convert_i32_u (local.get $g6))))
      (local.set $f6 (f64.sub (local.get $f6) (f64.add (local.get $f6) (f64.const 0.25))))
      (local.set $f7 (f64.add (f64.add (local.get $f7) (local.get $f8)) (f64.convert_i32_u (local.get $g7))))
      (local.set $f7 (f64.sub (local.get $f7) (f64.add (local.get $f7) (f64.const 0.25))))
      (local.set $f8 (f64.add (f64.add (local.get $f8) (local.get $f9)) (f64.convert_i32_u (local.get $g8))))
      (local.set $f8 (f64.sub (local.get $f8) (f64.add (local.get $f8) (f64.const 0.25))))
      (local.set $f9 (f64.add (f64.add (local.get $f9) (local.get $f10)) (f64.convert_i32_u (local.get $g9))))
      (local.set $f9 (f64.sub (local.get $f9) (f64.add (local.get $f9) (f64.const 0.25))))
      (local.set $f10 (f64.add (f64.add (local.get $f10) (local.get $f11)) (f64.convert_i32_u (local.get $g10))))
      (local.set $f10 (f64.sub (local.get $f10) (f64.add (local.get $f10) (f64.const 0.25))))
      (local.set $f11 (f64.add (f64.add (local.get $f11) (local.get $f0)) (f64.convert_i32_u (local.get $g11))))
      (local.set $f11 (f64.sub (local.get $f11) (f64.add (local.get $f11) (f64.const 0.25))))
      (local.set $v0 (i32x4.add (i32x4.mul (local.get $v0) (local.get $v1)) (i32x4.splat (local.get $g0))))
      (local.set $v1 (i32x4.add (i32x4.mul (local.get $v1) (local.get $v2)) (i32x4.splat (local.get $g1))))
      (local.set $v2 (i32x4.add (i32x4.mul (local.get $v2) (local.get $v3)) (i32x4.splat (local.get $g2))))
      (local.set $v3 (i32x4.add (i32x4.mul (local.get $v3) (local.get $v4)) (i32x4.splat (local.get $g3))))

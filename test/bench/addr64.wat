;; Addressing benchmarks: the addr64 variant.  GENERATED by test/gen_bench.py.
;;
;; Six kernels over three i32 arrays and two byte arrays, each taking its
;; element count as a parameter so the trip count is opaque to the
;; compiler.  The three variants differ only in where the arrays live and
;; how wide an index is; every export returns the same checksum in all
;; three, so comparing them is a test as well as a measurement.
(module
  (memory $m i64 1)

  ;; A, B and S get the same pseudorandom bytes in every variant, so the
  ;; checksums below can be compared across the three.
  (func $init (local $i i64) (local $s i32)
    (local.set $s (i32.const 0x2545F491))
    (loop $l
      (local.set $s (i32.xor (local.get $s) (i32.shl (local.get $s) (i32.const 13))))
      (local.set $s (i32.xor (local.get $s) (i32.shr_u (local.get $s) (i32.const 17))))
      (local.set $s (i32.xor (local.get $s) (i32.shl (local.get $s) (i32.const 5))))
      (i32.store offset=0 (i64.shl (local.get $i) (i64.const 2)) (local.get $s))
      (local.set $s (i32.xor (local.get $s) (i32.shl (local.get $s) (i32.const 13))))
      (local.set $s (i32.xor (local.get $s) (i32.shr_u (local.get $s) (i32.const 17))))
      (local.set $s (i32.xor (local.get $s) (i32.shl (local.get $s) (i32.const 5))))
      (i32.store offset=4096 (i64.shl (local.get $i) (i64.const 2)) (local.get $s))
      (local.set $s (i32.xor (local.get $s) (i32.shl (local.get $s) (i32.const 13))))
      (local.set $s (i32.xor (local.get $s) (i32.shr_u (local.get $s) (i32.const 17))))
      (local.set $s (i32.xor (local.get $s) (i32.shl (local.get $s) (i32.const 5))))
      (i32.store offset=16384 (i64.shl (local.get $i) (i64.const 2)) (local.get $s))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $l (i64.lt_u (local.get $i) (i64.const 1024)))))
  (start $init)

  ;; acc += A[i]
  (func (export "k_sum") (param $n i32) (result i32)
    (local $i i64) (local $acc i32)
    (if (i32.gt_u (local.get $n) (i32.const 1024))
      (then (local.set $n (i32.const 1024))))
    (block $done
      (br_if $done (i32.eqz (local.get $n)))
      (loop $l
        (local.set $acc (i32.add (local.get $acc) (i32.load offset=0 (i64.shl (local.get $i) (i64.const 2)))))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l (i64.lt_u (local.get $i) (i64.extend_i32_u (local.get $n))))))
    (local.get $acc))

  ;; C[i] = A[i]*3 + B[i], then acc += C[i] in a second pass
  (func (export "k_axpy") (param $n i32) (result i32)
    (local $i i64) (local $acc i32)
    (if (i32.gt_u (local.get $n) (i32.const 1024))
      (then (local.set $n (i32.const 1024))))
    (block $done
      (br_if $done (i32.eqz (local.get $n)))
      (loop $l
        (i32.store offset=8192 (i64.shl (local.get $i) (i64.const 2))
          (i32.add (i32.mul (i32.load offset=0 (i64.shl (local.get $i) (i64.const 2))) (i32.const 3))
                   (i32.load offset=4096 (i64.shl (local.get $i) (i64.const 2)))))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l (i64.lt_u (local.get $i) (i64.extend_i32_u (local.get $n)))))
      (local.set $i (i64.const 0))
      (loop $l2
        (local.set $acc (i32.add (local.get $acc) (i32.load offset=8192 (i64.shl (local.get $i) (i64.const 2)))))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l2 (i64.lt_u (local.get $i) (i64.extend_i32_u (local.get $n))))))
    (local.get $acc))

  ;; acc += A[B[i] & 1023] -- a data-dependent address
  (func (export "k_gather") (param $n i32) (result i32)
    (local $i i64) (local $acc i32)
    (if (i32.gt_u (local.get $n) (i32.const 1024))
      (then (local.set $n (i32.const 1024))))
    (block $done
      (br_if $done (i32.eqz (local.get $n)))
      (loop $l
        (local.set $acc (i32.add (local.get $acc) (i32.load offset=0 (i64.extend_i32_u (i32.shl (i32.and (i32.load offset=4096 (i64.shl (local.get $i) (i64.const 2))) (i32.const 1023)) (i32.const 2))))))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l (i64.lt_u (local.get $i) (i64.extend_i32_u (local.get $n))))))
    (local.get $acc))

  ;; a 256-bucket histogram of A's low byte, folded into one number
  (func (export "k_hist") (param $n i32) (result i32)
    (local $i i64) (local $acc i32) (local $p i64)
    (if (i32.gt_u (local.get $n) (i32.const 1024))
      (then (local.set $n (i32.const 1024))))
    (loop $z
      (i32.store offset=12288 (i64.shl (local.get $i) (i64.const 2)) (i32.const 0))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $z (i64.lt_u (local.get $i) (i64.const 256))))
    (local.set $i (i64.const 0))
    (block $done
      (br_if $done (i32.eqz (local.get $n)))
      (loop $l
        (local.set $p (i64.extend_i32_u (i32.shl (i32.and (i32.load offset=0 (i64.shl (local.get $i) (i64.const 2))) (i32.const 255)) (i32.const 2))))
        (i32.store offset=12288 (local.get $p) (i32.add (i32.load offset=12288 (local.get $p)) (i32.const 1)))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l (i64.lt_u (local.get $i) (i64.extend_i32_u (local.get $n))))))
    (local.set $i (i64.const 0))
    (loop $f
      (local.set $acc (i32.add (local.get $acc)
        (i32.mul (i32.load offset=12288 (i64.shl (local.get $i) (i64.const 2)))
                 (i32.add (i32.wrap_i64 (local.get $i)) (i32.const 1)))))
      (local.set $i (i64.add (local.get $i) (i64.const 1)))
      (br_if $f (i64.lt_u (local.get $i) (i64.const 256))))
    (local.get $acc))

  ;; D[i] = S[i] ^ 0x5a over 4n bytes, then acc += D[i]
  (func (export "k_bytes") (param $n i32) (result i32)
    (local $i i64) (local $acc i32) (local $nb i64)
    (if (i32.gt_u (local.get $n) (i32.const 1024))
      (then (local.set $n (i32.const 1024))))
    (local.set $nb (i64.extend_i32_u (i32.shl (local.get $n) (i32.const 2))))
    (block $done
      (br_if $done (i32.eqz (local.get $n)))
      (loop $l
        (i32.store8 offset=20480 (local.get $i)
          (i32.xor (i32.load8_u offset=16384 (local.get $i)) (i32.const 0x5a)))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l (i64.lt_u (local.get $i) (local.get $nb))))
      (local.set $i (i64.const 0))
      (loop $l2
        (local.set $acc (i32.add (local.get $acc) (i32.load8_u offset=20480 (local.get $i))))
        (local.set $i (i64.add (local.get $i) (i64.const 1)))
        (br_if $l2 (i64.lt_u (local.get $i) (local.get $nb)))))
    (local.get $acc))

  ;; p = A[p & 1023] & 1023 -- a dependent chain through memory
  (func (export "k_chase") (param $n i32) (result i32)
    (local $i i32) (local $p i32) (local $acc i32)
    (block $done
      (br_if $done (i32.eqz (local.get $n)))
      (loop $l
        (local.set $p (i32.and (i32.load offset=0 (i64.extend_i32_u (i32.shl (local.get $p) (i32.const 2)))) (i32.const 1023)))
        (local.set $acc (i32.add (local.get $acc) (local.get $p)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $l (i32.lt_u (local.get $i) (local.get $n)))))
    (local.get $acc))

  ;; What a call costs with none of the above in it, so the profiler's
  ;; per-launch floor can be subtracted from every row.
  (func (export "startup") (param i32) (result i32) (i32.const 0))
)
